# Скопируй этот файл в .env и впиши свои значения. .env НЕ коммитить (он в .gitignore).
# Значения без кавычек, одной строкой. Строки с # — комментарии.

# --- обязательное ---
TELEGRAM_TOKEN=
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=
# Твой Telegram ID (узнать: написать боту /myid). Он же админ.
ALLOWED_IDS=

# --- локальный запуск ---
# 1 = локальный режим (на Render эту переменную НЕ задавать)
USE_POLLING=1
# Папка всех данных: база, файлы, кэш кук, логи (bot.log), backup. Пусто = папка data рядом с ботом.
DATA_DIR=C:\bananagpt-data

# --- база ---
# Оставь пустым: тогда SQLite в DATA_DIR\bananbot.db. На Render здесь строка Postgres (Neon).
DATABASE_URL=

# --- необязательное ---
ADMIN_IDS=
MAX_USERS=10
DAILY_LIMIT=30
TZ_OFFSET_HOURS=3
ALLOW_REQUESTS=1
GEMINI_CONCURRENCY=2
HEALTH_INTERVAL=3600
LOG_LEVEL=INFO
# GEMINI_PROXY=         # прокси только для Gemini: http://127.0.0.1:порт или socks5://127.0.0.1:порт
# COOKIE_KEY=            # ключ шифрования сохранённых кук; по умолчанию берётся из токена бота
